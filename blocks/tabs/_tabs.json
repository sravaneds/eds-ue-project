{
  "definitions": [
    {
      "title": "Tabs",
      "id": "tabs",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Tabs",
              "model": "tabs",
              "filter": "tabs",
              "classes": "standard",
              "classes_orientation": "horizontal",
              "classes_alignment": "align-start",
              "classes_mobile": "mobile-scroll",
              "classes_theme": "theme-light",
              "classes_deeplink": true,
              "interval": 6
            }
          }
        }
      }
    },
    {
      "title": "Tab",
      "id": "tabs-item",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Tab",
              "model": "tabs-item",
              "title": "New Tab"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "tabs",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "title",
          "label": "Heading"
        },
        {
          "component": "select",
          "name": "titleType",
          "label": "Heading Type",
          "valueType": "string",
          "value": "h2",
          "options": [
            {
              "name": "H2",
              "value": "h2"
            },
            {
              "name": "H3",
              "value": "h3"
            },
            {
              "name": "H4",
              "value": "h4"
            }
          ]
        },
        {
          "component": "richtext",
          "valueType": "string",
          "name": "description",
          "label": "Description",
          "value": ""
        },
        {
          "component": "select",
          "name": "classes",
          "label": "Tab Style",
          "valueType": "string",
          "value": "standard",
          "options": [
            {
              "name": "Standard",
              "value": "standard"
            },
            {
              "name": "Underline",
              "value": "underline"
            },
            {
              "name": "Pill",
              "value": "pill"
            },
            {
              "name": "Card",
              "value": "card"
            },
            {
              "name": "Icon",
              "value": "icon-tabs"
            },
            {
              "name": "Numbered",
              "value": "numbered"
            },
            {
              "name": "Image",
              "value": "image"
            },
            {
              "name": "Mega",
              "value": "mega"
            }
          ]
        },
        {
          "component": "select",
          "name": "classes_orientation",
          "label": "Orientation",
          "description": "Vertical tabs switch to horizontal below desktop width",
          "valueType": "string",
          "value": "horizontal",
          "options": [
            {
              "name": "Horizontal",
              "value": "horizontal"
            },
            {
              "name": "Vertical",
              "value": "vertical"
            }
          ]
        },
        {
          "component": "select",
          "name": "classes_alignment",
          "label": "Alignment",
          "valueType": "string",
          "value": "align-start",
          "options": [
            {
              "name": "Start",
              "value": "align-start"
            },
            {
              "name": "Center",
              "value": "align-center"
            },
            {
              "name": "End",
              "value": "align-end"
            },
            {
              "name": "Full width (stretch)",
              "value": "align-stretch"
            }
          ]
        },
        {
          "component": "select",
          "name": "classes_mobile",
          "label": "Mobile Behaviour",
          "valueType": "string",
          "value": "mobile-scroll",
          "options": [
            {
              "name": "Scrollable tabs",
              "value": "mobile-scroll"
            },
            {
              "name": "Accordion",
              "value": "mobile-accordion"
            },
            {
              "name": "Dropdown",
              "value": "mobile-dropdown"
            }
          ]
        },
        {
          "component": "select",
          "name": "classes_theme",
          "label": "Theme Variant",
          "valueType": "string",
          "value": "theme-light",
          "options": [
            {
              "name": "Light",
              "value": "theme-light"
            },
            {
              "name": "Dark",
              "value": "theme-dark"
            },
            {
              "name": "Brand",
              "value": "theme-brand"
            }
          ]
        },
        {
          "component": "select",
          "name": "classes_size",
          "label": "Tab Size",
          "valueType": "string",
          "value": "size-default",
          "options": [
            {
              "name": "Default",
              "value": "size-default"
            },
            {
              "name": "Compact",
              "value": "compact"
            }
          ]
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "classes_icons",
          "label": "Enable Icons",
          "description": "Show each tab's icon",
          "value": false
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "classes_deeplink",
          "label": "Deep Linking",
          "description": "Update the URL (#tab-id) when a tab changes and open the tab from links",
          "value": true
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "classes_sticky",
          "label": "Sticky Tabs",
          "description": "Keep the tab bar visible while scrolling long panels",
          "value": false
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "classes_autorotate",
          "label": "Auto Rotation",
          "description": "Cycle through tabs until the visitor interacts. Off for visitors who prefer reduced motion.",
          "value": false
        },
        {
          "component": "number",
          "valueType": "number",
          "name": "interval",
          "label": "Auto Rotation Speed (seconds)",
          "value": 6,
          "validation": {
            "numberMin": 3,
            "numberMax": 30
          },
          "condition": {
            "===": [
              {
                "var": "classes_autorotate"
              },
              true
            ]
          }
        }
      ]
    },
    {
      "id": "tabs-item",
      "fields": [
        {
          "component": "tab",
          "name": "tabSettings",
          "label": "Tab"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "title",
          "label": "Tab Title",
          "required": true,
          "validation": {
            "maxLength": 60
          }
        },
        {
          "component": "aem-content",
          "valueType": "string",
          "name": "fragment",
          "label": "Tab Content (fragment)",
          "description": "Fragment page holding this tab's blocks (Hero, Cards, Columns, any project block). Loaded when the tab opens."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "anchor",
          "label": "Tab ID",
          "description": "Used for deep links (#tab-id). Lowercase letters, numbers and hyphens. Defaults to the tab title.",
          "validation": {
            "regExp": "^[a-z0-9-]*$",
            "customErrorMsg": "Use lowercase letters, numbers and hyphens only"
          }
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "icon",
          "label": "Icon",
          "description": "Name of an icon in the project's /icons folder, e.g. info"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "badge",
          "label": "Badge",
          "description": "Short label shown on the tab, e.g. New",
          "validation": {
            "maxLength": 20
          }
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "summary",
          "label": "Tab Description",
          "description": "Shown on Card, Image and Mega tab styles",
          "validation": {
            "maxLength": 160
          }
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "thumbnail",
          "label": "Tab Image Thumbnail",
          "description": "Shown on the Image tab style",
          "multi": false
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "active",
          "label": "Default Active",
          "description": "Open this tab when the page loads. The first active tab wins.",
          "value": false
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "disabled",
          "label": "Disabled",
          "value": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "analytics",
          "label": "Analytics Label",
          "description": "Sent with the tab change event for analytics"
        },
        {
          "component": "tab",
          "name": "tabLegacy",
          "label": "Legacy content"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "content_heading",
          "label": "Panel Heading",
          "description": "Deprecated: shown only when no Tab Content fragment is set. Move this content into a fragment."
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "content_headingType",
          "label": "Panel Heading Type",
          "value": "h3",
          "options": [
            {
              "name": "H3",
              "value": "h3"
            },
            {
              "name": "H4",
              "value": "h4"
            },
            {
              "name": "H5",
              "value": "h5"
            }
          ],
          "description": "Deprecated: shown only when no Tab Content fragment is set. Move this content into a fragment."
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "content_image",
          "label": "Panel Image",
          "multi": false,
          "description": "Deprecated: shown only when no Tab Content fragment is set. Move this content into a fragment."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "content_imageAlt",
          "label": "Panel Image Alt Text",
          "description": "Deprecated: shown only when no Tab Content fragment is set. Move this content into a fragment."
        },
        {
          "component": "richtext",
          "valueType": "string",
          "name": "content_richtext",
          "label": "Panel Content",
          "description": "Deprecated: shown only when no Tab Content fragment is set. Move this content into a fragment.",
          "value": ""
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "tabs",
      "components": [
        "tabs-item"
      ]
    }
  ]
}
