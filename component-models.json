      {
        "component": "aem-content",
        "valueType": "string",
        "name": "source",
        "label": "Spreadsheet",
        "description": "The spreadsheet page to show, e.g. /data/offices. It must be mapped in paths.json.",
        "required": true
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "caption",
        "label": "Caption",
        "description": "Describes the table for all readers and screen readers, e.g. \"Our offices\"",
        "validation": {
          "maxLength": 80
        }
      },
      {
        "component": "boolean",
        "valueType": "boolean",
        "name": "search",
        "label": "Show Search Box",
        "value": false
      }
    ]
  },
