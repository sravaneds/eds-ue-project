[
  {
    "id": "page-metadata",
    "fields": [
      {
        "component": "text",
        "valueType": "string",
        "name": "jcr:title",
        "label": "Title"
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "jcr:description",
        "label": "Description"
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "keywords",
        "multi": true,
        "label": "Keywords"
      },
      {
        "component": "aem-tag",
        "valueType": "string",
        "name": "cq:tags",
        "label": "Tags",
        "multi": true,
        "description": "Tags from the site taxonomy. Shown as tags on article pages; titles come from the Taxonomy page."
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "author",
        "label": "Author"
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "publication-date",
        "label": "Publication Date"
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "reading-time",
        "label": "Reading Time"
      },
      {
        "component": "aem-content",
        "name": "link",
        "label": "LinkOne"
      },
      {
        "component": "aem-content",
        "name": "linkTwo",
        "label": "LinkTwo"
      },
      {
        "component": "select",
        "name": "pageCategory",
        "label": "Page Category",
        "options": [
          {
            "name": "Default",
            "value": "default"
          },
          {
            "name": "Article",
            "value": "article"
          },
          {
            "name": "Blog",
            "value": "blog"
          },
          {
            "name": "New",
            "value": "new"
          }
        ]
      },
      {
        "component": "aem-content",
        "valueType": "string",
        "name": "nav",
        "label": "Navigation",
        "description": "Page holding this page's header (logos, menu links, ask bar). Defaults to /nav."
      },
      {
        "component": "aem-content",
        "valueType": "string",
        "name": "footer",
        "label": "Footer",
        "description": "Page holding this page's footer. Defaults to /footer."
      }
    ]
  },
  {
